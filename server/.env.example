# ─── OpsPulse API — environment template ─────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit your real .env.
#   Copy-Item .env.example .env

# ─── Server ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# error | warn | info | debug
LOG_LEVEL=debug

# ─── MongoDB ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/opspulse

# ─── JWT ─────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────
# Comma separated list of allowed frontend origins
# Comma separated list of browser origins allowed to call the API.
  # Add the deployed frontend origin or the browser gets a 403 and login
  # silently fails. A trailing slash is tolerated but not required.
  CORS_ORIGIN=http://localhost:5173,https://opspulsse-7.vercel.app

# ─── Health check limits ─────────────────────────────────────────────
# Fastest allowed interval in seconds (protects monitored targets)
MONITOR_MIN_INTERVAL_SECONDS=30
MONITOR_MAX_INTERVAL_SECONDS=86400
MONITOR_DEFAULT_INTERVAL_SECONDS=300
MONITOR_MIN_TIMEOUT_MS=1000
MONITOR_MAX_TIMEOUT_MS=30000
MONITOR_DEFAULT_TIMEOUT_MS=10000
# Response slower than this is reported as DEGRADED
MONITOR_DEGRADED_MS=3000
# Redirects are followed manually and re-validated each hop
MONITOR_MAX_REDIRECTS=3
MONITOR_MAX_BODY_BYTES=32768
MONITOR_USER_AGENT=OpsPulse-Monitor/1.0 (+https://github.com/opspulse)

# ─── Security ────────────────────────────────────────────────────────
# ⚠️  DANGEROUS. Leave false unless you deliberately want to monitor
#     services on your own private network (127.0.0.1, 10.x, 192.168.x).
ALLOW_PRIVATE_TARGETS=false

# ─── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=300

# ─── Data retention ──────────────────────────────────────────────────
# Days of check history kept in MongoDB. 0 = keep everything.
CHECK_RETENTION_DAYS=0

# ─── Scheduler ───────────────────────────────────────────────────────
# The in-process scheduler must run on exactly ONE backend instance.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULER_MAX_CONCURRENCY=10

# ─── SMTP (optional — email notifications) ───────────────────────────
# Leave blank to disable email. In-app notifications always work.
# Without SMTP the app reports "skipped", it never pretends to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=OpsPulse <noreply@opspulse.dev>