# ─── OpsPulse — Docker Compose environment ─────────────────────────
# Copy to `.env` in the same folder as docker-compose.yml:
#     Copy-Item .env.example .env
#
# Generate a strong JWT_SECRET:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ─── Required ───────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Ports ──────────────────────────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=5000
MONGO_PORT=27017

# ─── Database ───────────────────────────────────────────────────────
MONGO_DB_NAME=opspulse

# ─── Server ─────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:8080

# ─── Monitoring scheduler ───────────────────────────────────────────
# ⚠️ Run the scheduler on EXACTLY ONE backend replica.
#    With a single `backend` service this is already the case.
#    See README "Scaling the scheduler".
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULER_MAX_CONCURRENCY=10

# ─── Health check limits ────────────────────────────────────────────
MONITOR_MIN_INTERVAL_SECONDS=30
MONITOR_DEFAULT_INTERVAL_SECONDS=300
MONITOR_DEFAULT_TIMEOUT_MS=10000

# ─── Security ───────────────────────────────────────────────────────
# Keep false. Only true if you intentionally monitor internal addresses.
ALLOW_PRIVATE_TARGETS=false

# ─── Rate limiting ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# ─── Data retention ─────────────────────────────────────────────────
# Days of check history to keep. 0 = keep everything.
CHECK_RETENTION_DAYS=0

# ─── SMTP (optional) ────────────────────────────────────────────────
# Leave blank to disable email. In-app notifications always work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=OpsPulse <noreply@opspulse.dev>