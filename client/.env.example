# ─── OpsPulse frontend environment ───────────────────────────────────
# Copy to `.env` (Copy-Item .env.example .env)
# Vite only exposes variables that start with VITE_

# Base URL of the OpsPulse API.
# Leave empty when the frontend is served by the same host/proxy as the API
# (this is the default for Docker Compose, where nginx proxies /api).
VITE_API_BASE_URL=

# Optional: absolute API URL when the frontend is hosted separately.
# VITE_API_BASE_URL=http://localhost:5000

# Name shown in the UI
VITE_APP_NAME=OpsPulse